# ============================================================
# MOKSHA MUSIC — ENVIRONMENT CONFIGURATION
# ============================================================

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (SERVER-SIDE ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: YouTube Data API v3 (For Server-Side Sync Engine)
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-devotional-channel-id

# App URL Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
